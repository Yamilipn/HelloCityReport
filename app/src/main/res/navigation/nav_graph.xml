<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/listaIncidenciasFragment">

    <fragment
        android:id="@+id/listaIncidenciasFragment"
        android:name="com.example.hellocityreport.ui.ListaIncidenciasFragment"
        android:label="@string/title_incidencias">
        <action
            android:id="@+id/action_lista_to_detalle"
            app:destination="@id/detalleIncidenciaFragment" />
        <action
            android:id="@+id/action_lista_to_nueva"
            app:destination="@id/nuevaIncidenciaFragment" />
    </fragment>

    <fragment
        android:id="@+id/nuevaIncidenciaFragment"
        android:name="com.example.hellocityreport.ui.NuevaIncidenciaFragment"
        android:label="@string/title_nueva">
        <action
            android:id="@+id/action_nueva_to_lista"
            app:destination="@id/listaIncidenciasFragment"
            app:popUpTo="@id/listaIncidenciasFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/detalleIncidenciaFragment"
        android:name="com.example.hellocityreport.ui.DetalleIncidenciaFragment"
        android:label="@string/title_detalle">
        <argument
            android:name="incidenciaId"
            app:argType="integer" />
    </fragment>

</navigation>
